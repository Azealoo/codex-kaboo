# Copy to .env (git-ignored). Both values are public by design (they ship inside the app binary).
# The Convex deployment URL the web dashboard uses (`NEXT_PUBLIC_CONVEX_URL` in web/.env.local).
EXPO_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# The same Clerk instance as the dashboard (`NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY`).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…
